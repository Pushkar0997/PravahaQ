# ============================================================================
# PravahaQ v0.1.0 — Environment Configuration Template
# Copy to .env (`cp .env.example .env`) and populate hardware credentials
# ============================================================================

# --- Core Control Plane ---
PRAVAHA_ENV=development
PRAVAHA_LOG_LEVEL=INFO
PRAVAHA_DEFAULT_ALGORITHM=bf_dcqo
PRAVAHA_DEFAULT_SDK=qiskit
PRAVAHA_RANDOM_SEED=42

# --- Quantum Hardware Provider Credentials (Optional for Local Simulation) ---
IBM_QUANTUM_TOKEN=your_ibm_quantum_platform_api_token_here
IBM_QUANTUM_INSTANCE=ibm-q/open/main
IBM_TARGET_BACKEND=ibm_fez
IONQ_API_KEY=your_ionq_cloud_api_key_here
AWS_BRAKET_REGION=us-east-1

# --- Error Mitigation & Compiler Defaults ---
PRAVAHA_DEFAULT_SHOTS=2048
PRAVAHA_CVAR_ALPHA=0.20
PRAVAHA_ZNE_SCALE_FACTORS=1.0,3.0,5.0
PRAVAHA_BF_DCQO_ITERATIONS=4
PRAVAHA_MPS_MAX_BOND_DIM=32

# --- Infrastructure & Caching ---
PRAVAHA_ENABLE_CACHE=true
REDIS_URL=redis://localhost:6379/0
